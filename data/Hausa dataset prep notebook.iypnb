{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[],"dockerImageVersionId":28755,"isInternetEnabled":false,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"markdown","source":"### Hausa  to English word pair using the modern bible as initial dataset","metadata":{}},{"cell_type":"markdown","source":"---\n### Plan\nTo compare and extract sentence pairs from the translated hausa bible (Sabon Rai Don Kowa) and compare with \nmodern english translated bible version and later break down to word pairs\n\nevery development would be done here\n\nthe dataset would be publicly attached here because of am still getting the hang of github pr reviews push,pull and all😅\n\n- make sure to add 'Hausa and english datasets' via kaggle add input first","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19"}},{"cell_type":"markdown","source":"#### confirming dataset present","metadata":{}},{"cell_type":"code","source":"# confirming the file path exists in notebook\nimport os\n\nfor dirname, _, filenames in os.walk('/kaggle/input'):\n    for filename in filenames:\n        print(os.path.join(dirname, filename))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T18:38:56.586595Z","iopub.execute_input":"2026-09-25T18:38:56.587014Z","iopub.status.idle":"2026-09-25T18:38:56.601266Z","shell.execute_reply.started":"2026-09-25T18:38:56.586981Z","shell.execute_reply":"2026-09-25T18:38:56.600031Z"}},"outputs":[{"name":"stdout","text":"/kaggle/input/datasets/israelbajulaye/hausa-and-english-datasets/eng-web_vpl.txt\n/kaggle/input/datasets/israelbajulaye/hausa-and-english-datasets/hausa_vpl.txt\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"# also make sure to edit this to the unique path showing👆\neng_path = \"/kaggle/input/datasets/israelbajulaye/hausa-and-english-datasets/eng-web_vpl.txt\"\nhau_path = \"/kaggle/input/datasets/israelbajulaye/hausa-and-english-datasets/hausa_vpl.txt\"\n\n# Read first few lines and count total lines\nwith open(eng_path, 'r', encoding='utf-8') as f:\n    eng_lines = f.readlines()\n\nwith open(hau_path, 'r', encoding='utf-8') as f:\n    hau_lines = f.readlines()\n\nprint(f\"Total English verses/lines: {len(eng_lines)}\")\nprint(f\"Total Hausa verses/lines:   {len(hau_lines)}\")\nprint(\"-\" * 50)\n\nprint(\"Sample English line 1:\\n\", eng_lines[0].strip())\nprint(\"\\nSample Hausa line 1:\\n\", hau_lines[0].strip())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T18:39:01.151679Z","iopub.execute_input":"2026-09-25T18:39:01.152519Z","iopub.status.idle":"2026-09-25T18:39:01.362422Z","shell.execute_reply.started":"2026-09-25T18:39:01.152483Z","shell.execute_reply":"2026-09-25T18:39:01.361452Z"}},"outputs":[{"name":"stdout","text":"Total English verses/lines: 38058\nTotal Hausa verses/lines:   31087\n--------------------------------------------------\nSample English line 1:\n GEN 1:1 In the beginning, God created the heavens and the earth.\n\nSample Hausa line 1:\n GEN 1:1 A farko-farko, Allah ya halicci sama da ƙasa.\n","output_type":"stream"}],"execution_count":3},{"cell_type":"markdown","source":"#### extracting the verse key (e.g. GEN 1:1) and  finding the matching pairs, and cleaning the text:\n\nthe english bible contains Apocrypha or Septuagint not present in the hausa translated version hence the need for allignment, this removes this chapters not present in the hausa translated version","metadata":{}},{"cell_type":"code","source":"import re\n\n\ndef parse_vpl(lines):\n    data = {}\n    for line in lines:\n        line = line.strip()\n        if not line:\n            continue\n\n        # Each line is: BOOK CHAPTER:VERSE text...\n        # We split by space up to 2 times: ['GEN', '1:1', 'In the beginning...']\n        parts = line.split(maxsplit=2)\n        if len(parts) == 3: # confirm that the split sentence pair contains exactly 3 parts\n            # seperate them into verse and scripture pair\n            ref = f\"{parts[0]} {parts[1]}\"  # e.g., 'GEN 1:1'\n            text = parts[2]\n            data[ref] = text\n    return data\n\n\n# Parse both files\neng_dict = parse_vpl(eng_lines)\nhau_dict = parse_vpl(hau_lines)\n\n# Find matching verse IDs that exist in BOTH\ncommon_refs = sorted(list(set(eng_dict.keys()) & set(hau_dict.keys())))\n\nprint(f\"Total matching parallel verses: {len(common_refs):,}\")\nprint(\"-\" * 50)\n\n# Check a sample\nsample_ref = common_refs[31000]  # GEN 1:1\nprint(f\"Sample Reference: {sample_ref}\")\nprint(f\"EN: {eng_dict[sample_ref]}\")\nprint(f\"HA: {hau_dict[sample_ref]}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T18:39:07.938795Z","iopub.execute_input":"2026-09-25T18:39:07.939126Z","iopub.status.idle":"2026-09-25T18:39:08.068561Z","shell.execute_reply.started":"2026-09-25T18:39:07.939089Z","shell.execute_reply":"2026-09-25T18:39:08.067610Z"}},"outputs":[{"name":"stdout","text":"Total matching parallel verses: 31,083\n--------------------------------------------------\nSample Reference: ZEC 8:19\nEN: Yahweh of Armies says: “The fasts of the fourth, fifth, seventh, and tenth months shall be for the house of Judah joy, gladness, and cheerful feasts. Therefore love truth and peace.”\nHA: Ga abin da Ubangiji Maɗaukaki ya ce, “Azumin wata na huɗu, da na watan biyar, da na watan bakwai da na watan goma za su zama lokutan farin ciki da murna da kuma bukukkuwa na murna ga Yahuda. Saboda haka sai ku ƙaunaci gaskiya da salama.”\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"import re\nfrom collections import Counter, defaultdict\n\n\ndef clean_words(text):\n    # Lowercase and retain English letters, digits, and Hausa hooked letters: ɓ, ɗ, ƙ, 'y\n    text = text.lower()\n    return set(re.findall(r\"[a-z0-9ɓɗƙƴ']+\", text))\n\n\n# Step A: Build the distribution\neng_freq = Counter()\nhau_freq = Counter()\nco_occurrences = defaultdict(Counter)\n\nprint(\"Building co-occurrence distribution across all verses...\")\n\nfor ref in common_refs:\n    eng_words = clean_words(eng_dict[ref])\n    hau_words = clean_words(hau_dict[ref])\n\n    for e in eng_words:\n        eng_freq[e] += 1\n        for h in hau_words:\n            co_occurrences[e][h] += 1\n\n    for h in hau_words:\n        hau_freq[h] += 1\n\nprint(\"Distribution complete!\")\n\n\n# Step B: Function to lookup the top Hausa word for any English word\ndef translate_word(eng_word, top_n=5, min_co_occur=3):\n    eng_word = eng_word.lower()\n    if eng_word not in eng_freq:\n        return f\"'{eng_word}' not found in English corpus.\"\n\n    candidates = co_occurrences[eng_word]\n    scored = []\n\n    for hau_word, joint_count in candidates.items():\n        if joint_count < min_co_occur:\n            continue\n        # Dice score penalizes stopwords like 'da', 'ya', 'a', 'ne'\n        dice_score = (2.0 * joint_count) / (eng_freq[eng_word] + hau_freq[hau_word])\n        scored.append((hau_word, dice_score, joint_count))\n\n    scored.sort(key=lambda x: x[1], reverse=True)\n    return scored[:top_n]","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T18:39:13.212356Z","iopub.execute_input":"2026-09-25T18:39:13.212705Z","iopub.status.idle":"2026-09-25T18:39:22.305210Z","shell.execute_reply.started":"2026-09-25T18:39:13.212678Z","shell.execute_reply":"2026-09-25T18:39:22.304361Z"}},"outputs":[{"name":"stdout","text":"Building co-occurrence distribution across all verses...\nDistribution complete!\n","output_type":"stream"}],"execution_count":5},{"cell_type":"markdown","source":" #### the implementation of  co-occurrence distribution logic (with the Dice coefficient penalty for stopwords).\n basically every single word(the english dataset) is cross referenced with every other word in each scripture in the hausa dataset\n then a frequency distribution of each word relative to the other words is formed\n stop word are then penalised via the dice coefficient penalty\n this should produce a accurate word to word translation","metadata":{}},{"cell_type":"code","source":"test_words = [\"god\", \"earth\", \"heavens\", \"covenant\", \"water\", \"king\", \"faith\"]\n\nfor word in test_words:\n    results = translate_word(word, top_n=3)\n    print(f\"\\nEnglish: '{word}' (Total EN verses: {eng_freq[word]})\")\n    for hau_word, score, count in results:\n        print(\n            f\"   → Hausa: '{hau_word}' | Score: {score:.3f} | Co-occurred: {count} times\"\n        )\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T18:39:38.399314Z","iopub.execute_input":"2026-09-25T18:39:38.400201Z","iopub.status.idle":"2026-09-25T18:39:38.412761Z","shell.execute_reply.started":"2026-09-25T18:39:38.400165Z","shell.execute_reply":"2026-09-25T18:39:38.411922Z"}},"outputs":[{"name":"stdout","text":"\nEnglish: 'god' (Total EN verses: 3574)\n   → Hausa: 'allah' | Score: 0.808 | Co-occurred: 2621 times\n   → Hausa: 'ubangiji' | Score: 0.250 | Co-occurred: 1254 times\n   → Hausa: 'ya' | Score: 0.225 | Co-occurred: 2123 times\n\nEnglish: 'earth' (Total EN verses: 870)\n   → Hausa: 'duniya' | Score: 0.668 | Co-occurred: 565 times\n   → Hausa: 'ƙasa' | Score: 0.287 | Co-occurred: 244 times\n   → Hausa: 'sama' | Score: 0.192 | Co-occurred: 167 times\n\nEnglish: 'heavens' (Total EN verses: 145)\n   → Hausa: 'sammai' | Score: 0.657 | Co-occurred: 91 times\n   → Hausa: 'sararin' | Score: 0.137 | Co-occurred: 17 times\n   → Hausa: 'duniya' | Score: 0.128 | Co-occurred: 62 times\n\nEnglish: 'covenant' (Total EN verses: 322)\n   → Hausa: 'alkawari' | Score: 0.405 | Co-occurred: 130 times\n   → Hausa: 'alkawarin' | Score: 0.351 | Co-occurred: 100 times\n   → Hausa: 'akwatin' | Score: 0.255 | Co-occurred: 65 times\n\nEnglish: 'water' (Total EN verses: 373)\n   → Hausa: 'ruwa' | Score: 0.558 | Co-occurred: 242 times\n   → Hausa: 'ruwan' | Score: 0.167 | Co-occurred: 79 times\n   → Hausa: 'wanke' | Score: 0.160 | Co-occurred: 39 times\n\nEnglish: 'king' (Total EN verses: 1925)\n   → Hausa: 'sarki' | Score: 0.711 | Co-occurred: 1154 times\n   → Hausa: 'sarkin' | Score: 0.527 | Co-occurred: 709 times\n   → Hausa: 'ila' | Score: 0.175 | Co-occurred: 327 times\n\nEnglish: 'faith' (Total EN verses: 231)\n   → Hausa: 'bangaskiya' | Score: 0.721 | Co-occurred: 141 times\n   → Hausa: 'bangaskiyarku' | Score: 0.228 | Co-occurred: 30 times\n   → Hausa: 'bangaskiyar' | Score: 0.137 | Co-occurred: 17 times\n","output_type":"stream"}],"execution_count":6},{"cell_type":"markdown","source":"#### to make sure this is even more accurate and also to stay true to word to word pair, am adding a bidirectional confirmation\n\neach english word is translated to hausa , and also verified that it's hausa word translation to english is the same thing bidirectionally","metadata":{}},{"cell_type":"code","source":"# Function 1: Hausa -> English\ndef translate_hau_to_eng(hau_word, top_n=5, min_co_occur=3):\n    hau_word = hau_word.lower()\n    if hau_word not in hau_freq:\n        return f\"'{hau_word}' not found in Hausa corpus.\"\n\n    # Invert the search: check all English words that co-occurred with hau_word\n    scored = []\n    for eng_word, candidates in co_occurrences.items():\n        if hau_word in candidates:\n            joint_count = candidates[hau_word]\n            if joint_count < min_co_occur:\n                continue\n\n            dice_score = (2.0 * joint_count) / (\n                eng_freq[eng_word] + hau_freq[hau_word]\n            )\n            scored.append((eng_word, dice_score, joint_count))\n\n    scored.sort(key=lambda x: x[1], reverse=True)\n    return scored[:top_n]\n\n\n# Function 2: Mutual Agreement (Bidirectional Verifier)\ndef verify_bidirectional_match(eng_word, top_k=3):\n    \"\"\"Checks if English -> Hausa candidate also maps back to English in the top-k.\"\"\"\n    eng_word = eng_word.lower()\n    forward_matches = translate_word(eng_word, top_n=top_k)\n\n    if isinstance(forward_matches, str):\n        return forward_matches\n\n    verified_results = []\n\n    for hau_cand, fwd_score, fwd_count in forward_matches:\n        # Check backward direction\n        backward_matches = translate_hau_to_eng(hau_cand, top_n=top_k)\n\n        is_mutual = False\n        back_rank = None\n\n        if isinstance(backward_matches, list):\n            for rank, (back_eng, back_score, _) in enumerate(\n                backward_matches, start=1\n            ):\n                if back_eng == eng_word:\n                    is_mutual = True\n                    back_rank = rank\n                    break\n\n        verified_results.append(\n            {\n                \"hausa\": hau_cand,\n                \"score\": fwd_score,\n                \"co_count\": fwd_count,\n                \"mutual_verified\": is_mutual,\n                \"backward_rank\": back_rank,\n            }\n        )\n\n    return verified_results","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T18:39:51.008173Z","iopub.execute_input":"2026-09-25T18:39:51.008490Z","iopub.status.idle":"2026-09-25T18:39:51.018905Z","shell.execute_reply.started":"2026-09-25T18:39:51.008464Z","shell.execute_reply":"2026-09-25T18:39:51.017903Z"}},"outputs":[],"execution_count":7},{"cell_type":"code","source":"test_eng_words = [\n    \"covenant\",\n    \"light\",\n    \"peace\",\n    \"truth\",\n    \"spirit\",\n    \"heart\",\n    \"father\",\n]\n\nfor word in test_eng_words:\n    results = verify_bidirectional_match(word, top_k=3)\n    print(f\"\\nEnglish Word: '{word}'\")\n    for res in results:\n        status = (\n            f\"✅ VERIFIED (maps back at rank #{res['backward_rank']})\"\n            if res[\"mutual_verified\"]\n            else \"❌ ONE-WAY ONLY\"\n        )\n        print(\n            f\"   → Hausa: '{res['hausa']:<15}' | Score: {res['score']:.3f} | {status}\"\n        )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T18:55:26.012694Z","iopub.execute_input":"2026-09-25T18:55:26.013048Z","iopub.status.idle":"2026-09-25T18:55:26.145999Z","shell.execute_reply.started":"2026-09-25T18:55:26.013015Z","shell.execute_reply":"2026-09-25T18:55:26.144863Z"}},"outputs":[{"name":"stdout","text":"\nEnglish Word: 'covenant'\n   → Hausa: 'alkawari       ' | Score: 0.405 | ✅ VERIFIED (maps back at rank #1)\n   → Hausa: 'alkawarin      ' | Score: 0.351 | ✅ VERIFIED (maps back at rank #2)\n   → Hausa: 'akwatin        ' | Score: 0.255 | ✅ VERIFIED (maps back at rank #2)\n\nEnglish Word: 'light'\n   → Hausa: 'haske          ' | Score: 0.583 | ✅ VERIFIED (maps back at rank #1)\n   → Hausa: 'hasken         ' | Score: 0.336 | ✅ VERIFIED (maps back at rank #1)\n   → Hausa: 'duhu           ' | Score: 0.303 | ✅ VERIFIED (maps back at rank #2)\n\nEnglish Word: 'peace'\n   → Hausa: 'salama         ' | Score: 0.731 | ✅ VERIFIED (maps back at rank #1)\n   → Hausa: 'lafiya         ' | Score: 0.215 | ✅ VERIFIED (maps back at rank #2)\n   → Hausa: 'hadaya         ' | Score: 0.130 | ❌ ONE-WAY ONLY\n\nEnglish Word: 'truth'\n   → Hausa: 'gaskiya        ' | Score: 0.351 | ✅ VERIFIED (maps back at rank #1)\n   → Hausa: 'aminci         ' | Score: 0.117 | ❌ ONE-WAY ONLY\n   → Hausa: 'gaskiyar       ' | Score: 0.116 | ✅ VERIFIED (maps back at rank #1)\n\nEnglish Word: 'spirit'\n   → Hausa: 'ruhu           ' | Score: 0.637 | ✅ VERIFIED (maps back at rank #1)\n   → Hausa: 'ruhun          ' | Score: 0.359 | ✅ VERIFIED (maps back at rank #1)\n   → Hausa: 'tsarki         ' | Score: 0.165 | ✅ VERIFIED (maps back at rank #3)\n\nEnglish Word: 'heart'\n   → Hausa: 'zuciyata       ' | Score: 0.240 | ✅ VERIFIED (maps back at rank #1)\n   → Hausa: 'zuciya         ' | Score: 0.230 | ✅ VERIFIED (maps back at rank #1)\n   → Hausa: 'zuciyarsa      ' | Score: 0.181 | ✅ VERIFIED (maps back at rank #1)\n\nEnglish Word: 'father'\n   → Hausa: 'mahaifinsa     ' | Score: 0.341 | ✅ VERIFIED (maps back at rank #1)\n   → Hausa: 'mahaifin       ' | Score: 0.206 | ✅ VERIFIED (maps back at rank #2)\n   → Hausa: 'uba            ' | Score: 0.179 | ✅ VERIFIED (maps back at rank #1)\n","output_type":"stream"}],"execution_count":11},{"cell_type":"markdown","source":"## to allign with lalango specification","metadata":{}},{"cell_type":"markdown","source":"to expand from 3000 words to about 8000\n\nwe can \n\nAllow Many-to-One: Let multiple English words map to the same Hausa word (e.g., earth, land, and ground can all keep ƙasa).\nTop-3 Mutual Agreement: Instead of requiring Rank #1 both ways, accept if they are within each other's Top 3.\nLower threshold to 2 occurrences: Include words that appear at least twice.\nalso manually adding commonly used stop words","metadata":{"execution":{"iopub.status.busy":"2026-09-25T14:02:35.557368Z","iopub.execute_input":"2026-09-25T14:02:35.557681Z","iopub.status.idle":"2026-09-25T14:02:35.564408Z","shell.execute_reply.started":"2026-09-25T14:02:35.557655Z","shell.execute_reply":"2026-09-25T14:02:35.563161Z"}}},{"cell_type":"code","source":"import os\nimport random\nimport zipfile\nfrom IPython.display import FileLink\nimport pandas as pd\n\n# -------------------------------------------------------------------------\n# 1. CURATED STOP WORDS & FUNCTION WORDS (English -> Hausa)\n# Standard Hausa grammatical equivalents from linguistic sources\n# -------------------------------------------------------------------------\nMANUAL_STOPWORDS = [\n    # Conjunctions & Prepositions\n    (\"and\", \"da\"),\n    (\"and\", \"kuma\"),\n    (\"with\", \"da\"),\n    (\"in\", \"a\"),\n    (\"in\", \"cikin\"),\n    (\"inside\", \"ciki\"),\n    (\"at\", \"a\"),\n    (\"on\", \"a kan\"),\n    (\"upon\", \"bisa\"),\n    (\"of\", \"na\"),\n    (\"of\", \"ta\"),\n    (\"for\", \"don\"),\n    (\"for\", \"domin\"),\n    (\"from\", \"daga\"),\n    (\"to\", \"zuwa\"),\n    (\"to\", \"ga\"),\n    (\"by\", \"ta\"),\n    (\"through\", \"ta\"),\n    (\"about\", \"game da\"),\n    (\"against\", \"gaba da\"),\n    (\"between\", \"tsakanin\"),\n    (\"before\", \"kafin\"),\n    (\"after\", \"bayan\"),\n    (\"under\", \"ƙarƙashin\"),\n    (\"above\", \"bisa\"),\n    (\"over\", \"sama da\"),\n    (\"until\", \"har\"),\n    (\"since\", \"tun\"),\n    (\"without\", \"ba tare da\"),\n    (\"but\", \"amma\"),\n    (\"or\", \"ko\"),\n    (\"because\", \"domin\"),\n    (\"if\", \"idan\"),\n    (\"if\", \"in\"),\n    (\"while\", \"yayin da\"),\n    # Articles & Demonstratives\n    (\"the\", \"wannan\"),\n    (\"a\", \"wani\"),\n    (\"an\", \"wani\"),\n    (\"this\", \"wannan\"),\n    (\"that\", \"wancan\"),\n    (\"these\", \"waɗannan\"),\n    (\"those\", \"waɗancan\"),\n    # Pronouns\n    (\"i\", \"ni\"),\n    (\"i\", \"na\"),\n    (\"me\", \"ni\"),\n    (\"my\", \"nawa\"),\n    (\"mine\", \"nawa\"),\n    (\"you\", \"kai\"),\n    (\"you\", \"ke\"),\n    (\"you\", \"ku\"),\n    (\"your\", \"naka\"),\n    (\"your\", \"naki\"),\n    (\"your\", \"naku\"),\n    (\"he\", \"ya\"),\n    (\"he\", \"shi\"),\n    (\"him\", \"shi\"),\n    (\"his\", \"nasa\"),\n    (\"she\", \"ta\"),\n    (\"she\", \"ita\"),\n    (\"her\", \"ita\"),\n    (\"her\", \"nata\"),\n    (\"it\", \"shi\"),\n    (\"its\", \"nasa\"),\n    (\"we\", \"mu\"),\n    (\"we\", \"mun\"),\n    (\"us\", \"mu\"),\n    (\"our\", \"namu\"),\n    (\"they\", \"su\"),\n    (\"they\", \"sun\"),\n    (\"them\", \"su\"),\n    (\"their\", \"nasu\"),\n    # Question & Relative words\n    (\"who\", \"wanda\"),\n    (\"whom\", \"wanda\"),\n    (\"which\", \"wanda\"),\n    (\"what\", \"abin da\"),\n    (\"what\", \"me\"),\n    (\"where\", \"inda\"),\n    (\"where\", \"ina\"),\n    (\"when\", \"sa'ad da\"),\n    (\"when\", \"yaushe\"),\n    (\"why\", \"don me\"),\n    (\"why\", \"me ya sa\"),\n    (\"how\", \"yaya\"),\n    # Auxiliary verbs & Copulas\n    (\"is\", \"ne\"),\n    (\"is\", \"ce\"),\n    (\"are\", \"ne\"),\n    (\"are\", \"ce\"),\n    (\"was\", \"ne\"),\n    (\"were\", \"ne\"),\n    (\"be\", \"kasance\"),\n    (\"been\", \"kasance\"),\n    (\"being\", \"kasancewa\"),\n    (\"have\", \"da\"),\n    (\"has\", \"da\"),\n    (\"had\", \"da\"),\n    (\"do\", \"yi\"),\n    (\"does\", \"yi\"),\n    (\"did\", \"yi\"),\n    (\"will\", \"za\"),\n    (\"shall\", \"za\"),\n    (\"can\", \"iya\"),\n    (\"could\", \"iya\"),\n    (\"would\", \"za\"),\n    (\"should\", \"kamata\"),\n    (\"must\", \"dole\"),\n    # Negation & Affirmatives\n    (\"not\", \"ba\"),\n    (\"no\", \"a'a\"),\n    (\"yes\", \"i\"),\n    (\"never\", \"fau\"),\n    # Quantifiers & Adverbs\n    (\"all\", \"duka\"),\n    (\"some\", \"wasu\"),\n    (\"any\", \"kowane\"),\n    (\"every\", \"kowane\"),\n    (\"each\", \"kowanne\"),\n    (\"both\", \"duka biyu\"),\n    (\"few\", \"kaɗan\"),\n    (\"more\", \"ƙari\"),\n    (\"most\", \"mafi yawa\"),\n    (\"other\", \"wani\"),\n    (\"others\", \"wasu\"),\n    (\"only\", \"kawai\"),\n    (\"same\", \"iri ɗaya\"),\n    (\"so\", \"haka\"),\n    (\"than\", \"fiye da\"),\n    (\"too\", \"kuma\"),\n    (\"very\", \"sosai\"),\n    (\"just\", \"kawai\"),\n    (\"also\", \"kuma\"),\n    (\"as\", \"kamar\"),\n    (\"like\", \"kamar\"),\n    (\"again\", \"kuma\"),\n    (\"here\", \"nan\"),\n    (\"there\", \"can\"),\n    (\"now\", \"yanzu\"),\n    (\"then\", \"sa'an nan\"),\n]\n\n# -------------------------------------------------------------------------\n# 2. STATISTICAL EXTRACTION (Many-to-One, Unidirectional)\n# -------------------------------------------------------------------------\nword_pairs_set = set(MANUAL_STOPWORDS)\nstopword_eng_keys = {e for e, h in MANUAL_STOPWORDS}\n\nprint(\"Extracting all possible word pairs (unidirectional many-to-one)...\")\n\nfor eng_word, h_counts in co_occurrences.items():\n    # Only skip if already covered in manual stopwords\n    if eng_word in stopword_eng_keys:\n        continue\n\n    # Accept words with at least 2 occurrences in the Bible\n    if eng_freq[eng_word] < 2:\n        continue\n\n    best_h = None\n    best_score = -1.0\n\n    for hau_word, joint_count in h_counts.items():\n        if joint_count < 2:\n            continue\n\n        # Dice score\n        score = (2.0 * joint_count) / (eng_freq[eng_word] + hau_freq[hau_word])\n        if score > best_score:\n            best_score = score\n            best_h = hau_word\n\n    # Add the best Hausa word found for this English word\n    if best_h:\n        word_pairs_set.add((eng_word, best_h))\n\n# Convert to list and shuffle reproducible\nall_pairs = list(word_pairs_set)\nrandom.seed(42)\nrandom.shuffle(all_pairs)\n\ntotal_pairs = len(all_pairs)\nprint(f\"✅ Total word pairs generated: {total_pairs:,}\")\n\n# -------------------------------------------------------------------------\n# 3. SPLIT INTO ALL, TRAIN (80%), VAL (10%), TEST (10%)\n# -------------------------------------------------------------------------\ntrain_idx = int(total_pairs * 0.8)\nval_idx = int(total_pairs * 0.9)\n\ntrain_pairs = all_pairs[:train_idx]\nval_pairs = all_pairs[train_idx:val_idx]\ntest_pairs = all_pairs[val_idx:]\n\n# Output directory\noutput_dir = \"/kaggle/working/hausa_english_word_splits\"\nos.makedirs(output_dir, exist_ok=True)\n\n# Build DataFrames with ONLY 'english' and 'hausa' columns\ndf_all = pd.DataFrame(all_pairs, columns=[\"english\", \"hausa\"])\ndf_train = pd.DataFrame(train_pairs, columns=[\"english\", \"hausa\"])\ndf_val = pd.DataFrame(val_pairs, columns=[\"english\", \"hausa\"])\ndf_test = pd.DataFrame(test_pairs, columns=[\"english\", \"hausa\"])\n\ndf_all.to_csv(\n    os.path.join(output_dir, \"all.csv\"), index=False, encoding=\"utf-8\"\n)\ndf_train.to_csv(\n    os.path.join(output_dir, \"train.csv\"), index=False, encoding=\"utf-8\"\n)\ndf_val.to_csv(\n    os.path.join(output_dir, \"val.csv\"), index=False, encoding=\"utf-8\"\n)\ndf_test.to_csv(\n    os.path.join(output_dir, \"test.csv\"), index=False, encoding=\"utf-8\"\n)\n\nprint(f\"   - all.csv:   {len(df_all):,} pairs\")\nprint(f\"   - train.csv: {len(df_train):,} pairs (80%)\")\nprint(f\"   - val.csv:   {len(df_val):,} pairs (10%)\")\nprint(f\"   - test.csv:  {len(df_test):,} pairs (10%)\")\n\n# -------------------------------------------------------------------------\n# 4. ZIP THE 4 CSV FILES\n# -------------------------------------------------------------------------\nzip_file_path = \"/kaggle/working/hausa_english_word_dataset.zip\"\nwith zipfile.ZipFile(zip_file_path, \"w\", zipfile.ZIP_DEFLATED) as zipf:\n    for fname in [\"all.csv\", \"train.csv\", \"val.csv\", \"test.csv\"]:\n        zipf.write(os.path.join(output_dir, fname), arcname=fname)\n\nprint(f\"\\n📦 Successfully zipped to: {zip_file_path}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T18:40:36.961936Z","iopub.execute_input":"2026-09-25T18:40:36.962319Z","iopub.status.idle":"2026-09-25T18:40:37.711587Z","shell.execute_reply.started":"2026-09-25T18:40:36.962288Z","shell.execute_reply":"2026-09-25T18:40:37.710758Z"}},"outputs":[{"name":"stdout","text":"Extracting all possible word pairs (unidirectional many-to-one)...\n✅ Total word pairs generated: 8,480\n   - all.csv:   8,480 pairs\n   - train.csv: 6,784 pairs (80%)\n   - val.csv:   848 pairs (10%)\n   - test.csv:  848 pairs (10%)\n\n📦 Successfully zipped to: /kaggle/working/hausa_english_word_dataset.zip\n","output_type":"stream"}],"execution_count":8},{"cell_type":"code","source":"FileLink(\"hausa_english_word_dataset.zip\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T18:41:49.518581Z","iopub.execute_input":"2026-09-25T18:41:49.518963Z","iopub.status.idle":"2026-09-25T18:41:49.526340Z","shell.execute_reply.started":"2026-09-25T18:41:49.518926Z","shell.execute_reply":"2026-09-25T18:41:49.525510Z"}},"outputs":[{"execution_count":9,"output_type":"execute_result","data":{"text/plain":"/kaggle/working/hausa_english_word_dataset.zip","text/html":"<a href='hausa_english_word_dataset.zip' target='_blank'>hausa_english_word_dataset.zip</a><br>"},"metadata":{}}],"execution_count":9},{"cell_type":"code","source":"import re\n\n# -------------------------------------------------------------\n# 1. BUILD ENGLISH -> HAUSA DICTIONARY\n# Sourced from your expanded word pairs + manual stopwords\n# -------------------------------------------------------------\n# Using df_all or all_pairs generated in the previous step\neng_to_hau = {row[\"english\"].lower(): row[\"hausa\"] for _, row in df_all.iterrows()}\n\n# Ensure standard high-frequency stopwords take clean priority\nprimary_stopwords = {\n    \"and\": \"da\",\n    \"the\": \"wannan\",\n    \"in\": \"a\",\n    \"of\": \"na\",\n    \"to\": \"zuwa\",\n    \"with\": \"da\",\n    \"for\": \"don\",\n    \"is\": \"ne\",\n    \"are\": \"ne\",\n    \"was\": \"ne\",\n    \"were\": \"ne\",\n    \"he\": \"ya\",\n    \"she\": \"ta\",\n    \"they\": \"su\",\n    \"it\": \"shi\",\n    \"we\": \"mu\",\n    \"you\": \"ku\",\n    \"not\": \"ba\",\n    \"a\": \"wani\",\n    \"an\": \"wani\",\n    \"from\": \"daga\",\n}\neng_to_hau.update(primary_stopwords)\n\nprint(f\"✅ Loaded {len(eng_to_hau):,} English -> Hausa word mappings.\")\n\n\n# -------------------------------------------------------------\n# 2. SENTENCE TRANSLATOR FUNCTION\n# -------------------------------------------------------------\ndef translate_english_sentence(sentence):\n    matched_words = []\n    unmatched_words = []\n\n    def replace_word(match):\n        token = match.group(0)\n        lower_token = token.lower()\n\n        if lower_token in eng_to_hau:\n            translated = eng_to_hau[lower_token]\n            matched_words.append(token)\n\n            # Preserve capitalization style\n            if token.isupper():\n                return translated.upper()\n            elif token.istitle():\n                return translated.capitalize()\n            else:\n                return translated\n        else:\n            # Default back to original English word\n            unmatched_words.append(token)\n            return token\n\n    # Regex matches standard English words, digits, and apostrophes\n    translated_text = re.sub(r\"[a-zA-Z0-9']+\", replace_word, sentence)\n\n    total_words = len(matched_words) + len(unmatched_words)\n    coverage = (\n        (len(matched_words) / total_words * 100) if total_words > 0 else 0\n    )\n\n    return translated_text, coverage, unmatched_words\n\n\n# -------------------------------------------------------------\n# 3. INTERACTIVE ENGLISH-ONLY CLI\n# -------------------------------------------------------------\ndef run_translator():\n    print(\"=\" * 65)\n    print(\"🌍 English ➔ Hausa Word-by-Word Translator\")\n    print(\"Enter any English sentence to translate. Type 'q' or 'exit' to quit.\")\n    print(\"=\" * 65)\n\n    while True:\n        sentence = input(\"\\nEnter English sentence: \").strip()\n\n        if sentence.lower() in [\"q\", \"exit\"]:\n            print(\"\\nExiting translator. Goodbye!\")\n            break\n\n        if not sentence:\n            continue\n\n        translation, coverage, oov = translate_english_sentence(sentence)\n\n        print(\"-\" * 50)\n        print(f\"📖 English:  {sentence}\")\n        print(f\"✨ Hausa:    {translation}\")\n        print(f\"📊 Coverage: {coverage:.1f}%\")\n        if oov:\n            print(f\"ℹ️ Words kept in English (not found): {oov}\")\n        print(\"-\" * 50)\n\n\n# Launch the translator\nrun_translator()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-25T19:01:17.218522Z","iopub.execute_input":"2026-09-25T19:01:17.219576Z"}},"outputs":[{"name":"stdout","text":"✅ Loaded 8,458 English -> Hausa word mappings.\n=================================================================\n🌍 English ➔ Hausa Word-by-Word Translator\nEnter any English sentence to translate. Type 'q' or 'exit' to quit.\n=================================================================\n","output_type":"stream"},{"output_type":"stream","name":"stdin","text":"\nEnter English sentence:  i will be very great in the future\n"},{"name":"stdout","text":"--------------------------------------------------\n📖 English:  i will be very great in the future\n✨ Hausa:    ni za kasance sosai girma a wannan zuciya\n📊 Coverage: 100.0%\n--------------------------------------------------\n","output_type":"stream"}],"execution_count":null}]}
